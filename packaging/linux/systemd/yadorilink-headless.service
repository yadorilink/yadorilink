# systemd system unit: yadorilink-daemon as an always-on service for a
# headless Linux box (NAS, home server, mini PC) -- no login, no desktop
# session, starts at boot. The per-user unit (yadorilink-daemon.service) stays
# the choice for a machine somebody logs in to.
#
# Runs as the dedicated, unprivileged `yadorilink` account, never root. All
# state is under /var/lib/yadorilink (owner yadorilink, mode 0700): device
# identity, credentials.json (0600, file backend, the Linux default), the
# block store, the sync database and the control socket. The linked folders
# are ordinary directories the same account owns; see the install script.
#
# Settings live in /etc/yadorilink/headless.env, read here and by the
# `yadorilink-svc` wrapper so the daemon and the CLI always agree on the
# state directory. The file holds no secrets.
#
# Sandbox: written to leave file watching (inotify), extended attributes,
# fsync/rename durability and the loopback HTTP listener alone. Folders
# under /home are hidden by ProtectHome; keep them under /srv or /mnt, or
# see packaging/linux/README.md for the drop-in. For a folder on
# a separate disk add RequiresMountsFor= in a drop-in so the daemon never
# starts against an unmounted, empty directory.

[Unit]
Description=YadoriLink sync daemon (system service)
Documentation=https://github.com/yadorilink/yadorilink
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/var/lib/yadorilink
# A permanent failure (for example an unreadable credential file) retries
# every RestartSec rather than giving up: an appliance nobody is watching
# should come back by itself once the cause is fixed.
StartLimitIntervalSec=0

[Service]
Type=simple
User=yadorilink
Group=yadorilink
# This profile, and only this one, offers management of the device from the
# YadoriLink app of another device on the same account (over the device
# connection; no port is opened). Set here rather than in headless.env so an
# upgrade turns it on without editing that file. To turn it off, put
# YADORILINK_NAS_ADMIN=0 in headless.env, which is read after this line and
# wins.
Environment=YADORILINK_NAS_ADMIN=1
EnvironmentFile=/etc/yadorilink/headless.env
ExecStart=/usr/bin/yadorilink-daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
UMask=0027
StateDirectory=yadorilink
StateDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target

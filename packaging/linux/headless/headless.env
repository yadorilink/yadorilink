# /etc/yadorilink/headless.env -- settings for the yadorilink-headless
# service and the `yadorilink-svc` wrapper. Plain KEY=value lines, no quotes,
# no secrets: credentials live in the state directory, never here.

# State directory; must match StateDirectory= in the unit.
YADORILINK_CONFIG_DIR=/var/lib/yadorilink

# There is no desktop keyring for a service account; the owner-only
# credentials file inside the state directory is the credential store.
YADORILINK_CREDENTIAL_STORE=file
YADORILINK_DISABLE_OS_KEYRING=1

# Uncomment to use a coordination service other than the release default
# (also required for a local or disposable coordination worker).
#YADORILINK_COORDINATION_ADDR=https://coordination.example.net

# The local web dashboard listens on 127.0.0.1 only. A non-default port keeps
# it clear of the 8484 that a YadoriLink app on the machine you tunnel from
# already holds. Use the same number on both ends of any ssh -L.
YADORILINK_HTTP_API_PORT=18484

# Prometheus metrics, loopback only, off unless set.
#YADORILINK_DAEMON_METRICS_ADDR=127.0.0.1:9184

# Management from the YadoriLink app of another device on this account is on
# for this profile (the unit sets YADORILINK_NAS_ADMIN=1). Uncomment to turn
# it off.
#YADORILINK_NAS_ADMIN=0
